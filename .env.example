# The tutor service (ai/) reads these from a file named .env beside this one.

# The Azure OpenAI resource, for example https://<name>.openai.azure.com
AZURE_OPENAI_ENDPOINT=
# Its key
AZURE_OPENAI_KEY=
# The name of the deployment of the model (GPT-4.1)
AZURE_OPENAI_DEPLOYMENT=
# The API version, for example 2024-10-21
AZURE_OPENAI_API_VERSION=

# Where the tutor reads the learning material: the Prometej API
PROMETEJ_API_URL=https://localhost:7041
# The development certificate of the API as a PEM file, so that Python trusts it
PROMETEJ_API_CA_FILE=
